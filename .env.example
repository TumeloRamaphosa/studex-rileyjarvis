OPENAI_API_KEY=your_openai_api_key_here
EXA_API_KEY=your_exa_api_key_here
# Web/phone build only (npm run web). Long random string you enter once on each device.
JARVIS_ACCESS_TOKEN=
# 127.0.0.1 by default; set to the private network address to reach it from the phone.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
